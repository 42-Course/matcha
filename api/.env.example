DATABASE_URL=postgres://matcha:secret@db:5432/matcha_db
APP_ENV=development
JWT_SECRET=super_secret_key_for_matcha
RUBY_LOG_LEVEL=ERROR (optional)
REDIS_URL=redis://redis:6379/0
SMTP_ADDRESS=mailhog
SMTP_PORT=1025
SMTP_USERNAME=pulgamecanica
SMTP_PASSWORD=pulgamecnica
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
INTRA_CLIENT_ID=
INTRA_CLIENT_SECRET=
INTRA_CLIENT_NEXT_SECRET=
INTRA_REDIRECT_URI=

# Object storage (S3-compatible). In dev this points at the MinIO container.
# In production point S3_ENDPOINT at the minio Kamal accessory (or a real S3).
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=matcha-uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO/most self-hosted S3 need path-style URLs (bucket in the path, not host).
S3_FORCE_PATH_STYLE=true
# Public base URL used when building object URLs (browser-reachable host).
S3_PUBLIC_URL=http://localhost:9000/matcha-uploads